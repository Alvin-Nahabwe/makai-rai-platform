generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  assessor
}

enum AssessmentStatus {
  in_progress
  completed
}

enum AssessmentMode {
  full
  quick
}

enum ConsentType {
  terms_of_service
  privacy_policy
  research_data_usage
}

enum RemediationTier {
  gap
  attention
}

enum EvidenceLevel {
  self_attestation
  artifact_uploaded
}

enum DevelopmentStage {
  concept
  development
  testing
  deployed
  retired
}

enum DatasetSize {
  small_lt1k
  medium_1k_100k
  large_100k_1m
  very_large_gt1m
  unknown
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(assessor)
  isActive       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  termsAccepted  Boolean  @default(false)
  termsAcceptedAt DateTime?
  researchConsent Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  sessionEpoch        Int       @default(0)

  projects       Project[]
  assessments    Assessment[]
  consentRecords ConsentRecord[]
  completedRemediations RemediationItem[] @relation("CompletedBy")
  memberships      Membership[]
  sentInvitations  Invitation[] @relation("InvitedBy")
  uploadedEvidence Evidence[] @relation("EvidenceUploadedBy")
  lastActiveOrgId  String?      // plain column, NOT a FK — see note below

  @@map("users")
}

model Project {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  metadata    ProjectMetadata?
  assessments Assessment[]

  @@unique([orgId, id])
  @@index([orgId, createdById])
  @@map("projects")
}

model ProjectMetadata {
  id                  String    @id @default(uuid())
  orgId               String
  projectId           String
  project             Project   @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  aiSystemType        String?
  aiSystemTypeOther   String?
  institution         String?
  department          String?
  country             String?
  developmentStage    DevelopmentStage?
  deploymentSector    String?
  deploymentSectorOther String?
  targetPopulation    String?
  processesPersonalData Boolean?
  datasetSize         DatasetSize?
  datasetType         String?
  datasetTypeOther    String?
  datasetDescription  String?
  teamSize            Int?
  fundingSource       String?
  regulatoryContext   String?
  projectStart        DateTime?
  projectEnd          DateTime?

  updatedAt           DateTime  @updatedAt

  @@unique([orgId, projectId])
  @@map("project_metadata")
}

model Assessment {
  id           String           @id @default(uuid())
  orgId        String
  projectId    String
  project      Project          @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  status       AssessmentStatus @default(in_progress)
  mode         AssessmentMode   @default(full)
  frameworkVersionId String
  frameworkVersion   FrameworkVersion @relation(fields: [frameworkVersionId], references: [id])
  engineState  Json             // Full AssessmentEngine state as JSONB
  reportData   Json?            // generateReportData() output, cached on completion
  overallScore Int?             // 0-100, set on completion
  version      Int              @default(1)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?

  remediationItems RemediationItem[]
  evidence         Evidence[]

  @@unique([orgId, id])
  @@index([orgId, projectId])
  @@index([orgId, userId])
  @@index([frameworkVersionId])
  @@map("assessments")
}

/**
 * The first table that is neither tenant data nor identity data (Plan 1c,
 * ADR-0003 third lane). Global, read-mostly framework content metadata: no
 * "orgId" column, so the DDL guard (20260803074244_.../migration.sql) does
 * not touch it and it correctly gets no RLS. `makrai_app` holds SELECT only
 * (O-5) -- referential-integrity checks from `assessments.frameworkVersionId`
 * run with the REFERENCED table's rights, not the inserting role's (verified
 * by spike 2026-08-06), so even that SELECT is not required for the FK to
 * work; it exists solely for the report's provenance line.
 */
model FrameworkVersion {
  id          String       @id
  semver      String       @unique
  contentHash String
  publishedAt DateTime     @db.Timestamptz(3)
  status      String       @default("published")
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  assessments Assessment[]
  evidence    Evidence[]

  @@map("framework_versions")
}

model RemediationItem {
  id              String          @id @default(uuid())
  orgId           String
  assessmentId    String
  assessment      Assessment      @relation(fields: [orgId, assessmentId], references: [orgId, id], onDelete: Cascade)
  areaId          String
  areaName        String
  tier            RemediationTier
  description     String
  evidenceLevel   EvidenceLevel   @default(self_attestation)
  artifactPath    String?
  completed       Boolean         @default(false)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?           @relation("CompletedBy", fields: [completedById], references: [id])
  completionNotes String?
  createdAt       DateTime        @default(now())

  evidence        Evidence[]

  @@index([orgId, assessmentId])
  @@map("remediation_items")
}

model ConsentRecord {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  version     String      @default("1.0")
  granted     Boolean
  grantedAt   DateTime    @default(now())
  ipAddress   String?

  @@index([userId])
  @@map("consent_records")
}

enum OrgRole {
  owner
  admin
  assessor
  reviewer
  viewer
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]

  @@map("organizations")
}

model Membership {
  id     String           @id @default(uuid())
  orgId  String
  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   OrgRole
  status MembershipStatus @default(active)
  createdAt DateTime      @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        OrgRole
  tokenHash   String           @unique
  status      InvitationStatus @default(pending)
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@index([orgId, email])
  @@map("invitations")
}

/**
 * Plan 1c Task 3. The first place in this product a user's own bytes reach
 * the database: metadata here, the bytes themselves in EvidenceBlob (split
 * so a listing query never has to drag `bytea` out of TOAST — see the design
 * spec §2.3). Both tables carry "orgId", so the DDL guard
 * (20260803074244_.../migration.sql) auto-enables RLS and FORCE on each and
 * creates NO policy; migration 20260808140048_evidence_tables writes both.
 *
 * `@@unique([orgId, id])` is not requested by the task brief — it exists so
 * EvidenceBlob (below) can composite-FK to (orgId, id) instead of plain
 * `id`, the same "redundant but required" shape `Assessment`/`Project`
 * already use for their own children. See that migration's header comment
 * for the fresh C1 senior-security finding this closes.
 */
model Evidence {
  id                 String           @id @default(uuid())
  orgId              String
  assessmentId       String
  assessment         Assessment       @relation(fields: [orgId, assessmentId], references: [orgId, id], onDelete: Cascade)
  frameworkVersionId String
  frameworkVersion   FrameworkVersion @relation(fields: [frameworkVersionId], references: [id])

  questionId         String?
  remediationItemId  String?
  remediationItem    RemediationItem? @relation(fields: [remediationItemId], references: [id], onDelete: Cascade)

  filename           String
  mimeType           String
  byteSize           Int
  sha256             String
  uploadedById       String?
  uploadedBy         User?            @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt         DateTime         @default(now()) @db.Timestamptz(3)

  blob               EvidenceBlob?

  @@unique([orgId, id])
  @@index([orgId, assessmentId])
  @@index([remediationItemId])
  @@index([frameworkVersionId])
  @@index([uploadedById])
  @@map("evidence")
}

/**
 * 1:1 with Evidence, carrying "orgId" even though it is derivable through the
 * parent — deliberately, so the DDL guard's RLS auto-enable fires on the one
 * table holding the actual bytes too (do not "simplify" this column away).
 *
 * The relation below is a COMPOSITE FK to `evidence(orgId, id)`, not a plain
 * `evidenceId -> evidence.id` — see Evidence's doc comment and the migration
 * header for why: without it, this row's "orgId" (the column RLS actually
 * filters on) has no enforced relationship to its own parent's "orgId" at
 * all.
 *
 * `@@unique([orgId, evidenceId])` is required by Prisma's validator for a
 * one-to-one relation defined over two fields ("A one-to-one relation must
 * use unique fields on the defining side") — functionally redundant with the
 * "evidenceId" PK alone (which is already globally unique), but Prisma wants
 * the exact field tuple used by the relation proven unique, not just a
 * stricter subset. Backed by a real index in the migration so a future
 * `prisma migrate dev` sees the schema and the database agree, rather than
 * detecting drift.
 */
model EvidenceBlob {
  evidenceId String   @id
  orgId      String
  evidence   Evidence @relation(fields: [orgId, evidenceId], references: [orgId, id], onDelete: Cascade)
  content    Bytes

  @@unique([orgId, evidenceId])
  @@map("evidence_blobs")
}
