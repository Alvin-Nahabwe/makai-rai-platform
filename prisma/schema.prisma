generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  assessor
}

enum AssessmentStatus {
  in_progress
  completed
}

enum ConsentType {
  terms_of_service
  privacy_policy
  research_data_usage
  cross_border_storage
}

enum RemediationTier {
  gap
  attention
}

/**
 * Task 8 (Plan 1c), O-20: deliberately NOT attached to any column below.
 * `RemediationItem.evidenceLevel` (the column) is dropped in the
 * `drop_artifact_path_and_evidence_level` migration -- the value is now
 * computed fresh on every read from whether `evidence` rows exist for the
 * item (see `lib/data/evidence.ts#deriveEvidenceLevel`), never stored, so a
 * client can no longer assert it directly. This enum stays declared purely
 * as the TypeScript return type for that computed value -- Postgres and
 * Prisma both allow an enum type to exist with zero column references, and
 * dropping the type too would mean hand-rolling the same two-value union
 * with none of Prisma's generated-type safety. See task-8-report.md for why
 * the column was dropped rather than kept (the brief's own instruction),
 * and prisma/migrations/20260809130100_drop_artifact_path_and_evidence_level
 * for the migration.
 */
enum EvidenceLevel {
  self_attestation
  artifact_uploaded
}

enum DevelopmentStage {
  concept
  development
  testing
  deployed
  retired
}

enum DatasetSize {
  small_lt1k
  medium_1k_100k
  large_100k_1m
  very_large_gt1m
  unknown
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(assessor)
  isActive       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  termsAccepted  Boolean  @default(false)
  termsAcceptedAt DateTime?
  // Withdrawn at M0 (Task 15): no approved research protocol exists. The column and any stored
  // `true` are kept as audit evidence, marked void; users_research_consent_void_chk refuses
  // `researchConsent = true` without researchConsentVoidedAt. Nothing in the application writes it.
  researchConsent Boolean  @default(false)
  researchConsentVoidedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  sessionEpoch        Int       @default(0)

  projects       Project[]
  assessments    Assessment[]
  consentRecords ConsentRecord[]
  completedRemediations RemediationItem[] @relation("CompletedBy")
  memberships      Membership[]
  sentInvitations  Invitation[] @relation("InvitedBy")
  uploadedEvidence Evidence[] @relation("EvidenceUploadedBy")
  lastActiveOrgId  String?      // plain column, NOT a FK — see note below
  /// FR-FUP-06: reminder emails on or off (v0.6.0 step 2).
  reminderEmails   Boolean      @default(true)
  passwordResetTokens PasswordResetToken[]
  knownDevices        KnownDevice[]

  @@map("users")
}

model Project {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  /// FR-PRJ-03: archived is read-only (v0.6.0 step 3; read by assertProjectWritable).
  archivedAt  DateTime?    @db.Timestamptz(3)

  metadata    ProjectMetadata?
  assessments Assessment[]
  evidence          Evidence[]
  decisionVersions  DecisionVersion[]
  findings          Finding[]
  stageReviews      StageReview[]
  issuedDocuments   IssuedDocument[]
  draftFields       DocumentDraftFields[]

  @@unique([orgId, id])
  @@index([orgId, createdById])
  @@map("projects")
}

model ProjectMetadata {
  id                  String    @id @default(uuid())
  orgId               String
  projectId           String
  project             Project   @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  aiSystemType        String?
  aiSystemTypeOther   String?
  institution         String?
  department          String?
  country             String?
  developmentStage    DevelopmentStage?
  deploymentSector    String?
  deploymentSectorOther String?
  targetPopulation    String?
  processesPersonalData Boolean?
  datasetSize         DatasetSize?
  datasetType         String?
  datasetTypeOther    String?
  datasetDescription  String?
  teamSize            Int?
  fundingSource       String?
  regulatoryContext   String?
  projectStart        DateTime?
  projectEnd          DateTime?

  updatedAt           DateTime  @updatedAt

  @@unique([orgId, projectId])
  @@map("project_metadata")
}

model Assessment {
  id           String           @id @default(uuid())
  orgId        String
  projectId    String
  project      Project          @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  status       AssessmentStatus @default(in_progress)
  frameworkVersionId String
  frameworkVersion   FrameworkVersion @relation(fields: [frameworkVersionId], references: [id])
  engineState  Json             // Full AssessmentEngine state as JSONB
  reportData   Json?            // generateReportData() output, cached on completion
  overallScore Int?             // 0-100, set on completion
  scoringVersion String?        // SCORING_VERSION at completion; null for pre-6.0.0 rows
  version      Int              @default(1)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?

  remediationItems RemediationItem[]
  evidence         Evidence[]

  @@unique([orgId, id])
  @@index([orgId, projectId])
  @@index([orgId, userId])
  @@index([frameworkVersionId])
  @@map("assessments")
}

/**
 * The first table that is neither tenant data nor identity data (Plan 1c,
 * ADR-0003 third lane). Global, read-mostly framework content metadata: no
 * "orgId" column, so the DDL guard (20260803074244_.../migration.sql) does
 * not touch it and it correctly gets no RLS. `makrai_app` holds SELECT only
 * (O-5) -- referential-integrity checks from `assessments.frameworkVersionId`
 * run with the REFERENCED table's rights, not the inserting role's (verified
 * by spike 2026-08-06), so even that SELECT is not required for the FK to
 * work. It is load-bearing anyway, for two independent reasons: the report's
 * provenance line (`getPinnedVersion`), and resolving which row a NEW
 * assessment pins to at creation (`getCurrentVersionId`, closing D-143) --
 * corrected here from an earlier comment that named only the first. See
 * ADR-0003.
 */
model FrameworkVersion {
  id          String       @id
  semver      String       @unique
  contentHash String
  publishedAt DateTime     @db.Timestamptz(3)
  status      String       @default("published")
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  assessments Assessment[]
  evidence    Evidence[]
  decisionVersions DecisionVersion[]
  seals            Seal[]

  @@map("framework_versions")
}

/**
 * Task 8 (Plan 1c), O-20: `evidenceLevel` is NOT a column here — it is
 * computed on every read from whether any `evidence` row exists for the
 * item (see `lib/data/evidence.ts#deriveEvidenceLevel`), the same way every
 * client-facing serializer of this model must derive it (remediation
 * GET/PATCH, assessment-detail GET, project-detail GET). Before this task
 * it was a client-settable `PATCH .../remediation` field with nothing
 * behind it and nothing deriving it — a hand-settable enum asserting the
 * same fact a real evidence system already proved or disproved, able to
 * disagree with it. The column (and the never-written, never-read
 * `artifactPath`) were dropped in the
 * `drop_artifact_path_and_evidence_level` migration; see task-8-report.md
 * for why the column was dropped rather than kept as the brief specified.
 */
model RemediationItem {
  id              String          @id @default(uuid())
  orgId           String
  assessmentId    String
  assessment      Assessment      @relation(fields: [orgId, assessmentId], references: [orgId, id], onDelete: Cascade)
  areaId          String
  areaName        String
  tier            RemediationTier
  description     String
  completed       Boolean         @default(false)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?           @relation("CompletedBy", fields: [completedById], references: [id])
  completionNotes String?
  createdAt       DateTime        @default(now())

  evidence        Evidence[]

  @@index([orgId, assessmentId])
  @@map("remediation_items")
}

model ConsentRecord {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  version     String      @default("1.0")
  granted     Boolean
  grantedAt   DateTime    @default(now())
  ipAddress   String?
  // A void row stays as evidence of what was shown and clicked but no longer counts as consent.
  // consent_records_research_void_chk requires a research_data_usage row to carry voidedAt.
  voidedAt    DateTime?
  voidReason  String?
  /// SHA-256 of the legal text version accepted (FR-ACC-03; v0.6.0 step 2). Append-only from
  /// v0.6.0: "ipAddress" is cleared on every row and never written again (9.5 step 6).
  textHash    String?

  @@index([userId])
  @@map("consent_records")
}

enum OrgRole {
  owner
  admin
  assessor
  reviewer
  viewer
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// The institution's legal name; null for an organisation from before v0.6.1 with no agreement record to copy from.
  legalName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  agreements  OrganisationAgreement[]
  events          OrganisationEvent[]
  reminderLogs    ReminderLog[]
  tombstones      Tombstone[]
  requestReceipts RequestReceipt[]

  @@map("organizations")
}

model Membership {
  id     String           @id @default(uuid())
  orgId  String
  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   OrgRole
  status MembershipStatus @default(active)
  createdAt DateTime      @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        OrgRole
  tokenHash   String           @unique
  status      InvitationStatus @default(pending)
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?
  /// 'member' | 'first_owner' (types/record.ts InvitationKind), CHECK invitations_kind_check.
  kind             String    @default("member")
  /// FR-ACC-10: set in the same insert when the inviter pressed Show link.
  linkShownAt      DateTime? @db.Timestamptz(3)
  /// FR-ORG-02: reference of the controller's written request (a re-issued first owner).
  requestReference String?

  @@index([orgId, email])
  @@map("invitations")
}

/**
 * Plan 1c Task 3. The first place in this product a user's own bytes reach
 * the database: metadata here, the bytes themselves in EvidenceBlob (split
 * so a listing query never has to drag `bytea` out of TOAST — see the design
 * spec §2.3). Both tables carry "orgId", so the DDL guard
 * (20260803074244_.../migration.sql) auto-enables RLS and FORCE on each and
 * creates NO policy; migration 20260808140048_evidence_tables writes both.
 *
 * `@@unique([orgId, id])` is not requested by the task brief — it exists so
 * EvidenceBlob (below) can composite-FK to (orgId, id) instead of plain
 * `id`, the same "redundant but required" shape `Assessment`/`Project`
 * already use for their own children. See that migration's header comment
 * for the fresh C1 senior-security finding this closes.
 */
model Evidence {
  id                 String           @id @default(uuid())
  orgId              String
  /// Null on v1 rows (v0.6.0 step 3); a v0.5.0 row keeps its assessment.
  assessmentId       String?
  assessment         Assessment?       @relation(fields: [orgId, assessmentId], references: [orgId, id], onDelete: Cascade)
  frameworkVersionId String?
  frameworkVersion   FrameworkVersion? @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  /// v1 attach point (null only on v0.5.0 rows).
  projectId          String?
  project            Project?          @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  /// EvidenceKind, 'file' | 'link' (CHECK evidence_kind_check).
  kind               String            @default("file")

  questionId         String?
  remediationItemId  String?
  remediationItem    RemediationItem? @relation(fields: [remediationItemId], references: [id], onDelete: Cascade)

  filename           String?
  filenameSalt       Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  mimeType           String?
  byteSize           Int?
  sha256             String?
  url                String?
  urlSalt            Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  label              String?
  labelSalt          Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  /// Retry key (contract "Request columns"); null on v0.5.0 rows.
  requestId          String?           @db.Uuid
  requestDigest      String?
  /// Nullable, and NOTHING IN THE PRODUCT EVER NULLS IT. Added at the C6
  /// whole-branch review (F2), where the ABSENCE of this note was itself the
  /// problem: two route comments had filled the gap with a wrong explanation
  /// ("scrubbed on user erasure"). It cannot be that — `makrai_app` has no
  /// `UPDATE` grant on `evidence` by design (see the evidence_tables
  /// migration), so no column on an existing evidence row can be changed at
  /// all. User erasure scrubs the `users` row instead, so an erased uploader
  /// resolves to 'Deleted user'. The `ON DELETE SET NULL` below is likewise
  /// latent: `identityDb` exposes no delete operation and
  /// `scrubUserOnDeactivation` never deletes a `User`. See D-174.
  uploadedById       String?
  uploadedBy         User?            @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt         DateTime         @default(now()) @db.Timestamptz(3)

  blob               EvidenceBlob?
  decisionLinks      DecisionEvidence[]
  mitigationLinks    MitigationEvidence[]

  @@unique([orgId, id])
  @@unique([orgId, requestId])
  @@index([orgId, projectId])
  @@index([orgId, assessmentId])
  @@index([remediationItemId])
  @@index([frameworkVersionId])
  @@index([uploadedById])
  @@map("evidence")
}

/**
 * 1:1 with Evidence, carrying "orgId" even though it is derivable through the
 * parent — deliberately, so the DDL guard's RLS auto-enable fires on the one
 * table holding the actual bytes too (do not "simplify" this column away).
 *
 * The relation below is a COMPOSITE FK to `evidence(orgId, id)`, not a plain
 * `evidenceId -> evidence.id` — see Evidence's doc comment and the migration
 * header for why: without it, this row's "orgId" (the column RLS actually
 * filters on) has no enforced relationship to its own parent's "orgId" at
 * all.
 *
 * `@@unique([orgId, evidenceId])` is required by Prisma's validator for a
 * one-to-one relation defined over two fields ("A one-to-one relation must
 * use unique fields on the defining side") — functionally redundant with the
 * "evidenceId" PK alone (which is already globally unique), but Prisma wants
 * the exact field tuple used by the relation proven unique, not just a
 * stricter subset. Backed by a real index in the migration so a future
 * `prisma migrate dev` sees the schema and the database agree, rather than
 * detecting drift.
 */
model EvidenceBlob {
  evidenceId String   @id
  orgId      String
  evidence   Evidence @relation(fields: [orgId, evidenceId], references: [orgId, id], onDelete: Cascade)
  content    Bytes

  @@unique([orgId, evidenceId])
  @@map("evidence_blobs")
}

/**
 * The integrity log (ADR-0010): append-only and hash-chained, one row per event that
 * must stay visible afterwards (at M0, a console break-glass login).
 *
 * Declared so the schema and the database agree; nothing in the application reads or
 * writes it. Neither application role holds a grant on it, so either client would get
 * "permission denied". The one writer is the SQL function integrity_append(), run as the
 * schema owner by the PAM hook ops/host/makrai-break-glass-session. A trigger refuses
 * every UPDATE, DELETE and TRUNCATE (migration 20261008000200_integrity_log).
 *
 * `hash` is sha256 over prev_hash, seq, `at` (to_char, UTC, milliseconds), kind,
 * actor_ref and detail::text; ops/host/integrity-hash.mjs computes the same value.
 */
model IntegrityLogEntry {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq      BigInt   @unique
  at       DateTime @default(now()) @db.Timestamptz
  kind     String
  actorRef String   @map("actor_ref")
  detail   Json
  prevHash String   @map("prev_hash") @db.Char(64)
  hash     String   @db.Char(64)

  @@map("integrity_log")
}

/**
 * v0.6.0 identity lane (SRS 9.5 step 2). Password reset tokens (FR-ACC-06): only the hash of
 * the emailed token is stored; `usedAt` and `voidedAt` are set once (trigger
 * password_reset_tokens_set_once). makrai_identity: SELECT, INSERT, UPDATE ("usedAt",
 * "voidedAt"); makrai_definer: UPDATE ("voidedAt").
 */
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  voidedAt  DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

/** FR-ACC-05 (call R-49): a known browser's own failure count for an account. Identity lane. */
model KnownDevice {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedCount Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("known_devices")
}

/**
 * FR-ORG-09: an administrator action on an account that belongs to no organisation.
 * Append-only; written only by the definer function admin_set_account_active; no
 * application role reads it. `action` is a PlatformEventAction (types/record.ts).
 */
model PlatformEvent {
  id               String   @id @default(uuid())
  actorId          String
  action           String
  targetUserId     String
  requestReference String?
  /// Set by the database (trigger platform_events_db_time).
  at               DateTime @default(now()) @db.Timestamptz(3)

  @@index([at])
  @@map("platform_events")
}

/**
 * FR-ORG-01, 05, 06, 10: an organisation's agreement record. Append-only; written by the
 * definer functions; read by the app lane under org_isolation (S-30) and by the identity
 * lane through its read-only identity_lane policy (S-23, S-24).
 */
model OrganisationAgreement {
  id                  String       @id @default(uuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agreementVersion    String
  textHash            String
  acceptedOn          DateTime     @db.Date
  controllerLegalName String
  dpContactEmail      String
  recordedById        String
  /// Set by the database (trigger organization_agreements_db_time).
  recordedAt          DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orgId, recordedAt(sort: Desc)])
  @@map("organization_agreements")
}

// ─────────────────────────────────────────────────────────────────────────────
// v0.6.0 tenant tables (SRS 9.5 step 3; migration 20261030000300_v060_03_tenant).
// Names and columns are 00-contract.md's "Data model names". Every one has "orgId", forced
// RLS and org_isolation; the append-only ones refuse UPDATE, DELETE and TRUNCATE for every
// role (lib/data/appendOnly.ts). "(db)" times are set by a trigger from the database clock;
// salts default to 16 random bytes and are never passed by a writer; status sets are String
// fields with a CHECK, whose values are the unions of types/record.ts. Partial unique indexes
// (findings_shortfall_question_idx, reminder_log_one_sent_key, reminder_log_one_claim_key,
// evidence_dedup_key) live in the migration only: Prisma does not model them.
// ─────────────────────────────────────────────────────────────────────────────

/** FR-ORG-09: administrator actions and membership changes. orgId defaults to the transaction's organisation. */
model OrganisationEvent {
  id                 String       @id @default(uuid())
  /// The column's database default is NULLIF(current_setting('app.current_org_id', true), '') (migration
  /// 20261030000300_v060_03_tenant). Prisma does not introspect a NULLIF default, so it is not repeated
  /// here (C4 CR-2): a client create passes orgId, and lib/data/orgEvents.ts inserts without it.
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorId            String
  /// ActorRole: an OrgRole or 'platform_admin'.
  actorRole          String
  /// OrgEventAction.
  action             String
  targetUserId       String?
  targetInvitationId String?
  reason             String?
  requestReference   String?
  /// The earlier organisation name (FR-ORG-10).
  previousValue      String?
  at                 DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orgId, at])
  @@map("organisation_events")
}

model DecisionVersion {
  id                 String           @id @default(uuid())
  orgId              String
  projectId          String
  project            Project          @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Stage.
  stage              String
  questionId         String
  contentVersionId   String
  contentVersion     FrameworkVersion @relation(fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versionNumber      Int
  baseVersionNumber  Int?
  /// StoredDecisionStatus; exactly one of status and scopeAnswer is set (decision_versions_answer_check).
  status             String?
  /// ScopeAnswer.
  scopeAnswer        String?
  optionsInPlace     String[]         @default([])
  reasonCode         String?
  reason             String?
  reasonSalt         Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  decidedByUserId    String?
  /// OutsideRole; at most one of decidedByUserId and decidedByRole.
  decidedByRole      String?
  declaredOn         DateTime?        @db.Date
  /// DeclaredPrecision; set exactly when declaredOn is.
  declaredPrecision  String?
  /// WithdrawalCode.
  withdrawalCode     String?
  enteredById        String
  enteredByRole      OrgRole
  receivedAt         DateTime         @default(now()) @db.Timestamptz(3)
  requestId          String           @db.Uuid
  requestDigest      String

  evidence           DecisionEvidence[]
  findings           Finding[]
  closingMitigations MitigationVersion[]

  @@unique([orgId, id])
  @@unique([orgId, projectId, questionId, versionNumber])
  @@unique([orgId, requestId])
  @@index([orgId, projectId, stage, questionId, versionNumber(sort: Desc)], map: "decision_versions_orgId_projectId_stage_questionId_versionNumbe")
  @@index([contentVersionId])
  @@map("decision_versions")
}

model DecisionEvidence {
  orgId      String
  versionId  String
  version    DecisionVersion @relation(fields: [orgId, versionId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  evidenceId String
  evidence   Evidence        @relation(fields: [orgId, evidenceId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([orgId, versionId, evidenceId])
  @@index([orgId, evidenceId])
  @@map("decision_evidence")
}

model Finding {
  id                 String           @id @default(uuid())
  orgId              String
  projectId          String
  project            Project          @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  stage              String
  /// FindingSource; a shortfall names its question and decision version (findings_shortfall_check).
  source             String
  questionId         String?
  decisionVersionId  String?
  decisionVersion    DecisionVersion? @relation(fields: [orgId, decisionVersionId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  riskArea           String?
  title              String?
  titleSalt          Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  description        String?
  descriptionSalt    Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  raisedById         String
  raisedAt           DateTime         @default(now()) @db.Timestamptz(3)
  requestId          String           @db.Uuid
  requestDigest      String

  events             FindingEvent[]
  mitigationVersions MitigationVersion[]
  acceptedRisks      AcceptedRisk[]

  @@unique([orgId, id])
  @@unique([orgId, requestId])
  @@index([orgId, projectId, stage])
  @@index([orgId, decisionVersionId])
  @@map("findings")
}

/**
 * findingSeq (SRS 5.3 item 11) is enforced across finding_events, mitigation_versions and
 * accepted_risks by the trigger finding_seq_assign(): a writer passes the next number, or
 * none and the trigger assigns it, at READ COMMITTED, under the per-finding advisory lock.
 */
model FindingEvent {
  id            String   @id @default(uuid())
  orgId         String
  findingId     String
  finding       Finding  @relation(fields: [orgId, findingId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  /// FindingEventKind.
  kind          String
  eventCode     String?
  reason        String?
  reasonSalt    Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  byId          String
  at            DateTime @default(now()) @db.Timestamptz(3)
  findingSeq    Int
  requestId     String   @db.Uuid
  requestDigest String

  @@unique([orgId, findingId, findingSeq])
  @@unique([orgId, requestId])
  @@index([findingId, at])
  @@map("finding_events")
}

model MitigationVersion {
  id                       String           @id @default(uuid())
  orgId                    String
  findingId                String
  finding                  Finding          @relation(fields: [orgId, findingId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  mitigationId             String
  versionNumber            Int
  baseVersionNumber        Int?
  what                     String?
  whatSalt                 Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  changeNote               String?
  changeNoteSalt           Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  ownerUserId              String
  dueDate                  DateTime         @db.Date
  /// MitigationStatus.
  status                   String
  /// MitigationKind.
  kind                     String
  followsControl           String?
  closureNote              String?
  closureNoteSalt          Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  closureDecisionVersionId String?
  closureDecisionVersion   DecisionVersion? @relation(fields: [orgId, closureDecisionVersionId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  cancelReason             String?
  cancelReasonSalt         Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  enteredById              String
  enteredByRole            OrgRole
  findingSeq               Int
  receivedAt               DateTime         @default(now()) @db.Timestamptz(3)
  requestId                String           @db.Uuid
  requestDigest            String

  evidence                 MitigationEvidence[]

  @@unique([orgId, id])
  @@unique([orgId, mitigationId, versionNumber])
  @@unique([orgId, findingId, findingSeq])
  @@unique([orgId, requestId])
  @@index([orgId, ownerUserId, dueDate])
  @@index([orgId, closureDecisionVersionId])
  @@map("mitigation_versions")
}

model MitigationEvidence {
  orgId      String
  versionId  String
  version    MitigationVersion @relation(fields: [orgId, versionId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  evidenceId String
  evidence   Evidence          @relation(fields: [orgId, evidenceId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([orgId, versionId, evidenceId])
  @@index([orgId, evidenceId])
  @@map("mitigation_evidence")
}

model AcceptedRisk {
  id                String    @id @default(uuid())
  orgId             String
  findingId         String
  finding           Finding   @relation(fields: [orgId, findingId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  /// A member or an outside role (OutsideRole), never both.
  acceptedByUserId  String?
  acceptedByRole    String?
  accepterRole      OrgRole?
  reason            String?
  reasonSalt        Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  lookAgainNote     String?
  lookAgainNoteSalt Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  lookAgainOn       DateTime? @db.Date
  enteredById       String
  enteredByRole     OrgRole
  findingSeq        Int
  receivedAt        DateTime  @default(now()) @db.Timestamptz(3)
  requestId         String    @db.Uuid
  requestDigest     String

  @@unique([orgId, findingId, findingSeq])
  @@unique([orgId, requestId])
  @@map("accepted_risks")
}

model StageReview {
  id              String   @id @default(uuid())
  orgId           String
  projectId       String
  project         Project  @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  stage           String
  numberInStage   Int
  preparedFor     String?
  preparedForSalt Bytes?   @default(dbgenerated("((SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 6)) || SUBSTRING(uuid_send(gen_random_uuid()) FROM 1 FOR 4))"))
  openedById      String
  openedAt        DateTime @default(now()) @db.Timestamptz(3)
  requestId       String   @db.Uuid
  requestDigest   String

  seals           Seal[]
  issuedDocuments IssuedDocument[]

  @@unique([orgId, id])
  @@unique([orgId, projectId, stage, numberInStage])
  @@unique([orgId, requestId])
  @@map("stage_reviews")
}

/** sealedAt is the transaction's time (trigger seals_db_time; gap G012). */
model Seal {
  id               String           @id @default(uuid())
  orgId            String
  stageReviewId    String
  stageReview      StageReview      @relation(fields: [orgId, stageReviewId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  sealNumber       Int
  /// 'makrai.seal/1'.
  format           String
  contentVersionId String
  contentVersion   FrameworkVersion @relation(fields: [contentVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  manifest         Bytes
  fingerprint      String
  sealedById       String
  sealedByRole     OrgRole
  sealedAt         DateTime         @default(now()) @db.Timestamptz(3)
  requestId        String           @db.Uuid
  requestDigest    String

  issuedDocuments  IssuedDocument[]
  documentSeals    IssuedDocumentSeal[]

  @@unique([orgId, id])
  @@unique([orgId, stageReviewId, sealNumber])
  @@unique([orgId, requestId])
  @@index([contentVersionId])
  @@map("seals")
}

/**
 * issuedAt is written by DOC-a: a whole second within the 120 s up to the database clock
 * (CHECK and trigger issued_documents_check_insert, gap G065). pdf and plainText are written
 * at issue and nulled only by the operator's erasure functions.
 */
model IssuedDocument {
  id              String      @id @default(uuid())
  orgId           String
  projectId       String
  project         Project     @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  stageReviewId   String
  stageReview     StageReview @relation(fields: [orgId, stageReviewId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  sealId          String
  seal            Seal        @relation(fields: [orgId, sealId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  /// DocumentType.
  documentType    String
  templateVersion String
  /// TypedFieldValue[]; each element's salt is written by DOC-a (finding R2-11).
  typedFields     Json        @default("[]")
  pdf             Bytes?
  plainText       String?
  sha256          String
  byteSize        Int
  issuedById      String
  issuedAt        DateTime    @db.Timestamptz(3)
  requestId       String      @db.Uuid
  requestDigest   String

  seals           IssuedDocumentSeal[]
  sources         IssuedDocumentSource[]
  events          DocumentEvent[]

  @@unique([orgId, id])
  @@unique([orgId, sealId, documentType, issuedAt], map: "issued_documents_second_key")
  @@unique([orgId, requestId])
  @@index([orgId, projectId])
  @@index([orgId, stageReviewId])
  @@map("issued_documents")
}

model IssuedDocumentSeal {
  orgId      String
  documentId String
  document   IssuedDocument @relation(fields: [orgId, documentId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  sealId     String
  seal       Seal           @relation(fields: [orgId, sealId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([orgId, documentId, sealId])
  @@index([orgId, sealId])
  @@map("issued_document_seals")
}

/** One row per record field or evidence file a document prints (SRS 5.6); followed by the erasure functions. */
model IssuedDocumentSource {
  id          String         @id @default(uuid())
  orgId       String
  documentId  String
  document    IssuedDocument @relation(fields: [orgId, documentId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceTable String
  sourceId    String
  /// The digest field name (Types, "Digest field names"); null for an evidence file.
  field       String?

  @@index([orgId, sourceTable, sourceId])
  @@index([orgId, documentId])
  @@map("issued_document_sources")
}

model DocumentEvent {
  id            String         @id @default(uuid())
  orgId         String
  documentId    String
  document      IssuedDocument @relation(fields: [orgId, documentId], references: [orgId, id], onDelete: Restrict, onUpdate: Restrict)
  /// 'withdrawn'.
  kind          String
  reason        String
  byId          String
  at            DateTime       @default(now()) @db.Timestamptz(3)
  requestId     String         @db.Uuid
  requestDigest String

  @@unique([orgId, requestId])
  @@index([orgId, documentId])
  @@map("document_events")
}

/** Last values of a project's document-only fields (not append-only; makrai_app may UPDATE). */
model DocumentDraftFields {
  id           String   @id @default(uuid())
  orgId        String
  projectId    String
  project      Project  @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade, onUpdate: Restrict)
  /// DocumentType.
  documentType String
  /// Record<string, string>.
  fieldValues  Json     @default("{}")
  updatedById  String
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([orgId, projectId, documentType])
  @@map("document_draft_fields")
}

/** Reached only through systemContext (lib/data/tenant.ts); no other module names this model (NFR-SEC-09). */
model ReminderLog {
  id           String       @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mitigationId String
  dueDate      DateTime     @db.Date
  /// ReminderKind.
  kind         String
  attempt      Int
  /// ReminderOutcome.
  outcome      String
  failureCode  String?
  at           DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([orgId, mitigationId, dueDate, kind, attempt, outcome], map: "reminder_log_orgId_mitigationId_dueDate_kind_attempt_outcome_ke")
  @@map("reminder_log")
}

/** Written only by the operator's erasure functions; makrai_app holds SELECT only. */
model Tombstone {
  id                   String       @id @default(uuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetTable          String
  targetId             String
  field                String?
  digest               String?
  erasureCode          String
  instructionReference String
  at                   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orgId, targetTable, targetId])
  @@map("tombstones")
}

/**
 * Owner answer A1 (contract New models row, round 9): the receipt of a retry-keyed write
 * whose effect is not an IdempotentTable row. Written by idempotentWrite's receipt mode;
 * result holds only non-secret response fields; no status column.
 */
model RequestReceipt {
  id            String       @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestId     String       @db.Uuid
  requestDigest String
  actorUserId   String
  route         String
  rowId         String?
  result        Json?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([orgId, requestId])
  @@map("request_receipts")
}
