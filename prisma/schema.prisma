generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  assessor
}

enum AssessmentStatus {
  in_progress
  completed
}

enum AssessmentMode {
  full
  quick
}

enum ConsentType {
  terms_of_service
  privacy_policy
  research_data_usage
}

enum RemediationTier {
  gap
  attention
}

enum EvidenceLevel {
  self_attestation
  artifact_uploaded
}

enum DevelopmentStage {
  concept
  development
  testing
  deployed
  retired
}

enum DatasetSize {
  small_lt1k
  medium_1k_100k
  large_100k_1m
  very_large_gt1m
  unknown
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(assessor)
  isActive       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  termsAccepted  Boolean  @default(false)
  termsAcceptedAt DateTime?
  researchConsent Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  projects       Project[]
  assessments    Assessment[]
  consentRecords ConsentRecord[]
  completedRemediations RemediationItem[] @relation("CompletedBy")
  memberships      Membership[]
  sentInvitations  Invitation[] @relation("InvitedBy")
  lastActiveOrgId  String?      // plain column, NOT a FK — see note below

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  orgId       String?  // Multi-tenancy prep — nullable
  name        String
  description String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metadata    ProjectMetadata?
  assessments Assessment[]

  @@index([createdById])
  @@index([orgId])
  @@map("projects")
}

model ProjectMetadata {
  id                  String    @id @default(uuid())
  projectId           String    @unique
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  aiSystemType        String?
  aiSystemTypeOther   String?
  institution         String?
  department          String?
  country             String?
  developmentStage    DevelopmentStage?
  deploymentSector    String?
  deploymentSectorOther String?
  targetPopulation    String?
  processesPersonalData Boolean?
  datasetSize         DatasetSize?
  datasetType         String?
  datasetTypeOther    String?
  datasetDescription  String?
  teamSize            Int?
  fundingSource       String?
  regulatoryContext   String?
  projectStart        DateTime?
  projectEnd          DateTime?

  updatedAt           DateTime  @updatedAt

  @@map("project_metadata")
}

model Assessment {
  id           String           @id @default(uuid())
  orgId        String?          // Multi-tenancy prep — nullable
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  status       AssessmentStatus @default(in_progress)
  mode         AssessmentMode   @default(full)
  engineState  Json             // Full AssessmentEngine state as JSONB
  reportData   Json?            // generateReportData() output, cached on completion
  overallScore Int?             // 0-100, set on completion
  version      Int              @default(1)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?

  remediationItems RemediationItem[]

  @@index([projectId])
  @@index([userId])
  @@index([orgId])
  @@map("assessments")
}

model RemediationItem {
  id              String          @id @default(uuid())
  assessmentId    String
  assessment      Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  areaId          String
  areaName        String
  tier            RemediationTier
  description     String
  evidenceLevel   EvidenceLevel   @default(self_attestation)
  artifactPath    String?
  completed       Boolean         @default(false)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?           @relation("CompletedBy", fields: [completedById], references: [id])
  completionNotes String?
  createdAt       DateTime        @default(now())

  @@index([assessmentId])
  @@map("remediation_items")
}

model ConsentRecord {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  version     String      @default("1.0")
  granted     Boolean
  grantedAt   DateTime    @default(now())
  ipAddress   String?

  @@index([userId])
  @@map("consent_records")
}

enum OrgRole {
  owner
  admin
  assessor
  reviewer
  viewer
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  // NOTE: `projects Project[]` is deliberately NOT declared here. Prisma
  // requires both sides of a relation to exist, and Project does not gain its
  // back-reference until Task 2. Adding it now makes `prisma validate` fail.

  @@map("organizations")
}

model Membership {
  id     String           @id @default(uuid())
  orgId  String
  org    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   OrgRole
  status MembershipStatus @default(active)
  createdAt DateTime      @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        OrgRole
  token       String           @unique
  status      InvitationStatus @default(pending)
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@index([orgId, email])
  @@map("invitations")
}
