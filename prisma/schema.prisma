generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  assessor
}

enum AssessmentStatus {
  in_progress
  completed
}

enum AssessmentMode {
  full
  quick
}

enum ConsentType {
  terms_of_service
  privacy_policy
  research_data_usage
}

enum RemediationTier {
  gap
  attention
}

enum EvidenceLevel {
  self_attestation
  artifact_uploaded
}

enum DevelopmentStage {
  concept
  development
  testing
  deployed
  retired
}

enum DatasetSize {
  small_lt1k
  medium_1k_100k
  large_100k_1m
  very_large_gt1m
  unknown
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(assessor)
  isActive       Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  termsAccepted  Boolean  @default(false)
  termsAcceptedAt DateTime?
  researchConsent Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastActiveOrgId String?

  projects       Project[]
  assessments    Assessment[]
  consentRecords ConsentRecord[]
  completedRemediations RemediationItem[] @relation("CompletedBy")
  memberships    Membership[]

  @@map("users")
}

model Project {
  id          String   @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metadata    ProjectMetadata?
  assessments Assessment[]

  @@unique([orgId, id])
  @@index([createdById])
  @@index([orgId, createdAt])
  @@index([orgId, createdById])
  @@map("projects")
}

model ProjectMetadata {
  id                  String    @id @default(uuid())
  orgId               String
  projectId           String
  project             Project   @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)

  aiSystemType        String?
  aiSystemTypeOther   String?
  institution         String?
  department          String?
  country             String?
  developmentStage    DevelopmentStage?
  deploymentSector    String?
  deploymentSectorOther String?
  targetPopulation    String?
  processesPersonalData Boolean?
  datasetSize         DatasetSize?
  datasetType         String?
  datasetTypeOther    String?
  datasetDescription  String?
  teamSize            Int?
  fundingSource       String?
  regulatoryContext   String?
  projectStart        DateTime?
  projectEnd          DateTime?

  updatedAt           DateTime  @updatedAt

  @@unique([orgId, projectId])
  @@map("project_metadata")
}

model Assessment {
  id           String           @id @default(uuid())
  orgId        String
  projectId    String
  project      Project          @relation(fields: [orgId, projectId], references: [orgId, id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  status       AssessmentStatus @default(in_progress)
  mode         AssessmentMode   @default(full)
  engineState  Json             // Full AssessmentEngine state as JSONB
  reportData   Json?            // generateReportData() output, cached on completion
  overallScore Int?             // 0-100, set on completion
  version      Int              @default(1)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?

  remediationItems RemediationItem[]

  @@unique([orgId, id])
  @@index([orgId, projectId])
  @@index([orgId, status])
  @@index([orgId, userId])
  @@map("assessments")
}

model RemediationItem {
  id              String          @id @default(uuid())
  orgId           String
  assessmentId    String
  assessment      Assessment      @relation(fields: [orgId, assessmentId], references: [orgId, id], onDelete: Cascade)
  areaId          String
  areaName        String
  tier            RemediationTier
  description     String
  evidenceLevel   EvidenceLevel   @default(self_attestation)
  artifactPath    String?
  completed       Boolean         @default(false)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?           @relation("CompletedBy", fields: [completedById], references: [id])
  completionNotes String?
  createdAt       DateTime        @default(now())

  @@index([orgId, assessmentId])
  @@map("remediation_items")
}

model ConsentRecord {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  version     String      @default("1.0")
  granted     Boolean
  grantedAt   DateTime    @default(now())
  ipAddress   String?

  @@index([userId])
  @@map("consent_records")
}

enum OrgRole {
  owner
  admin
  assessor
  reviewer
  viewer
}

enum MembershipStatus {
  active
  suspended
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]

  @@map("organizations")
}

model Membership {
  id        String           @id @default(uuid())
  orgId     String
  userId    String
  role      OrgRole
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid())
  orgId       String
  email       String
  role        OrgRole
  tokenHash   String           @unique
  expiresAt   DateTime
  status      InvitationStatus @default(pending)
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@map("invitations")
}
