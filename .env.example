DATABASE_URL="postgresql://makrai:makrai_dev_password@localhost:5432/makrai"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
RESEND_API_KEY="re_your_api_key"
# Resend's shared testing sender. Delivers ONLY to the address that owns the
# API key above, until a custom domain is verified in Resend (see
# lib/email/send.ts and the Task 9 report for the documentation citation).
EMAIL_FROM_ADDRESS="onboarding@resend.dev"

# Evidence storage caps (NFR-REL-09). Optional; a value that is not a positive whole number
# of bytes is ignored and the default below is used. Not secrets.
# MAKRAI_ORG_STORAGE_CAP_BYTES=1073741824
# MAKRAI_ACCOUNT_UPLOAD_BYTES_PER_DAY=209715200

ADMIN_EMAIL="admin@air.ug"
# REQUIRED for `npm run db:seed`: set a real secret before seeding. The seed
# refuses (exit 1, naming this variable) when it is empty, and refuses a
# known-bad literal such as "change-me-on-first-login". It never generates a
# password and never prints this value or ADMIN_EMAIL: the migrator's output
# goes to the host journal. The admin must change it at first login.
ADMIN_PASSWORD=""
ADMIN_NAME="Platform Admin"

# Restricted app role. Create with `prisma migrate deploy`, then `npm run db:provision`
# (local only: it sets ALLOW_DEV_DB_PASSWORD=1 and provisions the dev passwords below).
#
# !! PRODUCTION: THIS PASSWORD MUST BE CHANGED. !!
# `app_dev_password` is a deliberate, well-known LOCAL/CI default -- the same
# literal appears in scripts/provision-app-db-role.sh, vitest.config.ts and
# .github/workflows/ci.yml, and all four must agree for local setup to work,
# which is why it is a real value here and not a placeholder.
#
# It is published in a public repository. `makrai_app` is the role RLS tenant
# isolation depends on (ADR-0001): anyone who can reach the database with these
# credentials can set any org id and read every tenant. The provisioning script
# refuses this password unless ALLOW_DEV_DB_PASSWORD=1, whatever NODE_ENV says
# (D-076) -- and refuses it even when passed explicitly as APP_DB_PASSWORD.
# Production: never run `npm run db:provision`. Generate a secret on the server
# and provision it with scripts/provision-app-db-role.sh as
# docs/runbooks/deployment.md section 6.4 shows; put the SAME secret here.
APP_DATABASE_URL="postgresql://makrai_app:app_dev_password@localhost:5432/makrai"

# Identity lane role (ADR-0009): sign-in, registration, invitations and organisation
# creation connect as `makrai_identity`. Created by `prisma migrate deploy`, password
# set by `npm run db:provision` locally. The app refuses to start without this, and
# refuses to start if it names a superuser or BYPASSRLS role (instrumentation.ts).
#
# !! PRODUCTION: THIS PASSWORD MUST BE CHANGED. !!
# `identity_dev_password` is the well-known LOCAL/CI default, shared with
# scripts/provision-app-db-role.sh, vitest.config.ts and .github/workflows/ci.yml for
# the same reason as `app_dev_password` above, and published with it. This role reads
# every account's password hash and every organisation, membership and invitation. The
# provisioning script refuses this password unless ALLOW_DEV_DB_PASSWORD=1.
# Production: never run `npm run db:provision`; see docs/runbooks/deployment.md
# section 6.4. Use a hex secret (`openssl rand -hex 32`): it needs no URL-encoding.
IDENTITY_DATABASE_URL="postgresql://makrai_identity:identity_dev_password@localhost:5432/makrai"

# Token for the reminder job's internal route (FR-OPS-02): exactly 64 lowercase hex characters.
# Generate on the host: openssl rand -hex 32. Never paste it into an AI session.
# Production only; the web container is the only one that receives it. Empty: the route refuses every call.
REMINDER_JOB_TOKEN=
