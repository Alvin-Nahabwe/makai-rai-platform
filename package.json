{
  "name": "toolkit-platform",
  "version": "0.1.0",
  "description": "Multi-tenant Responsible AI governance platform: assess AI systems against a research-grounded framework, attach evidence, and generate audit-ready reports. Aligned to ISO/IEC 42001 and the African Union Continental AI Strategy.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvin-Nahabwe/makai-rai-platform.git"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/.env*",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:security": "node scripts/pen-test.mjs",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:provision": "export ALLOW_DEV_DB_PASSWORD=1 && scripts/provision-app-db-role.sh makrai makrai_app && scripts/provision-app-db-role.sh makrai makrai_identity && scripts/provision-app-db-role.sh makrai_test makrai_app && scripts/provision-app-db-role.sh makrai_test makrai_identity",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "verify": "npm run lint && npm run test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
