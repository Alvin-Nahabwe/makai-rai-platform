#!/usr/bin/env bash
printf 'journalctl %s\n' "$*" >> "$REC/argv"
case "$*" in
  *CONTAINER_TAG=makrai/docker-nextjs-1*) f=journal-nextjs ;;
  *CONTAINER_TAG=makrai/docker-postgres-1*) f=journal-postgres ;;
  *) f=journal-all ;;
esac
[ ! -f "$WORLD/$f" ] || cat "$WORLD/$f"
# journal-fields: what only `-o export` (every field, _CMDLINE among them) shows, and `-o cat` (MESSAGE only) does not
case "$*" in *'-o export'*) [ "$f" != journal-all ] || [ ! -f "$WORLD/journal-fields" ] || cat "$WORLD/journal-fields" ;; esac
exit 0
